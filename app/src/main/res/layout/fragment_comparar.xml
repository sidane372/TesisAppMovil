<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pagina_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="19dp"
        android:paddingBottom="28dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/comparar_titulo"
            android:textAppearance="@style/SC.Title" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/comparar_descripcion"
            android:textAppearance="@style/SC.Secondary"
            android:layout_marginTop="8dp" />
        <TextView
            android:id="@+id/comparar_estado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cargando_datos"
            android:textAppearance="@style/SC.Secondary"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite" />
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/comparar_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:indeterminate="true"
            android:contentDescription="@string/cargando_datos" />
        <TextView
            android:id="@+id/comparar_vacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/comparar_vacio"
            android:textAppearance="@style/SC.Body"
            android:padding="21dp"
            android:background="@drawable/bg_card"
            android:layout_marginTop="16dp" />
        <LinearLayout
            android:id="@+id/comparar_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/comparar_explorar"
            style="@style/SC.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/explorar_musicos"
            android:layout_marginTop="12dp"
            android:maxLines="3" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/comparar_limpiar"
            style="@style/SC.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/limpiar_comparacion"
            android:layout_marginTop="12dp"
            android:maxLines="3" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
