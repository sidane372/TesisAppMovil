<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView
        android:id="@+id/form_rol_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/responsable"
        android:textAppearance="@style/SC.Secondary" />
    <Spinner
        android:id="@+id/form_selector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:padding="8dp"
        android:background="@drawable/bg_card" />
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/field_nombre"
        style="@style/SC.Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/nombre_servicio">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_nombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:inputType="textCapWords"
            android:maxLength="160"
            android:minLines="1"
            android:gravity="top|start" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/field_ciudad"
        style="@style/SC.Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/ciudad">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_ciudad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:inputType="textCapWords"
            android:maxLength="100"
            android:minLines="1"
            android:gravity="top|start" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/field_generos"
        style="@style/SC.Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/generos">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_generos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:inputType="textCapSentences"
            android:maxLength="2458"
            android:minLines="1"
            android:gravity="top|start" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/field_instrumentos"
        style="@style/SC.Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/instrumentos">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_instrumentos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:inputType="textCapSentences"
            android:maxLength="3278"
            android:minLines="1"
            android:gravity="top|start" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/field_tiposEvento"
        style="@style/SC.Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/tipos_evento">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_tiposEvento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:inputType="textCapSentences"
            android:maxLength="3058"
            android:minLines="1"
            android:gravity="top|start" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/field_experiencia"
        style="@style/SC.Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/experiencia">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_experiencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="500"
            android:minLines="3"
            android:gravity="top|start" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/field_tarifa"
        style="@style/SC.Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/tarifa">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_tarifa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:inputType="numberDecimal"
            android:maxLength="15"
            android:minLines="1"
            android:gravity="top|start" />
    </com.google.android.material.textfield.TextInputLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tarifa_ayuda"
        android:textAppearance="@style/SC.Secondary"
        android:layout_marginTop="6dp" />
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/field_incluye"
        style="@style/SC.Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/incluye">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_incluye"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="10000"
            android:minLines="4"
            android:gravity="top|start" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
