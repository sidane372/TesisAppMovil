<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView
        android:id="@+id/form_rol_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/rol"
        android:textAppearance="@style/SC.Eyebrow"
        android:layout_marginBottom="8dp" />
    <Spinner
        android:id="@+id/form_selector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:padding="8dp"
        android:background="@drawable/bg_card" />
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/field_nombres"
        style="@style/SC.Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/nombres">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_nombres"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:inputType="textPersonName|textCapWords"
            android:maxLength="100"
            android:minLines="1"
            android:gravity="top|start" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/field_apellidos"
        style="@style/SC.Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/apellidos">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_apellidos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:inputType="textPersonName|textCapWords"
            android:maxLength="120"
            android:minLines="1"
            android:gravity="top|start" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/field_correo"
        style="@style/SC.Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/correo">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_correo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:inputType="textEmailAddress"
            android:maxLength="254"
            android:minLines="1"
            android:gravity="top|start"
            android:singleLine="true"
            android:autofillHints="emailAddress" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/field_password"
        style="@style/SC.Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/password">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:inputType="textPassword"
            android:maxLength="72"
            android:minLines="1"
            android:gravity="top|start"
            android:saveEnabled="false"
            android:autofillHints="newPassword" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/field_telefono"
        style="@style/SC.Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/telefono">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_telefono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:inputType="phone"
            android:maxLength="24"
            android:minLines="1"
            android:gravity="top|start" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/field_ciudad"
        style="@style/SC.Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/ciudad">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_ciudad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:inputType="textCapWords"
            android:maxLength="100"
            android:minLines="1"
            android:gravity="top|start" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/field_biografia"
        style="@style/SC.Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/biografia">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_biografia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="1000"
            android:minLines="4"
            android:gravity="top|start" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
