<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="21dp"
    android:layout_marginTop="16dp">
    <TextView
        android:id="@+id/comparacion_nombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nombre_servicio"
        android:textAppearance="@style/SC.Heading" />
    <TextView
        android:id="@+id/comparacion_datos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/informacion"
        android:textAppearance="@style/SC.Body"
        android:layout_marginTop="16dp" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/comparacion_perfil"
        style="@style/SC.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ver_perfil"
        android:layout_marginTop="12dp"
        android:maxLines="3" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/comparacion_quitar"
        style="@style/SC.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/quitar_comparacion"
        android:layout_marginTop="12dp"
        android:maxLines="3" />
</LinearLayout>
