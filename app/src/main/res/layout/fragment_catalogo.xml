<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pagina_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="19dp"
        android:paddingBottom="28dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/talento_tierra"
            android:textAppearance="@style/SC.Eyebrow" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/explorar_musicos"
            android:textAppearance="@style/SC.Title"
            android:layout_marginTop="8dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/catalogo_subtitulo"
            android:textAppearance="@style/SC.Secondary"
            android:layout_marginTop="8dp" />
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/field_busqueda"
                app:startIconDrawable="@drawable/ic_search"
            style="@style/SC.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/busqueda_label" app:helperText="@string/busqueda_ayuda">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_busqueda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:inputType="text"
                android:maxLength="120"
                android:minLines="1"
                android:gravity="top|start"
                android:singleLine="true"
                android:imeOptions="actionSearch" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/catalogo_filtros_toggle"
            style="@style/SC.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/filtrar"
            android:layout_marginTop="12dp"
            android:maxLines="3" />
        <LinearLayout
            android:id="@+id/catalogo_filtros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="16dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_soft">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tipo_servicio"
                android:textAppearance="@style/SC.Secondary" />
            <Spinner
                android:id="@+id/catalogo_tipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:padding="8dp"
                android:background="@drawable/bg_card" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/genero"
                android:textAppearance="@style/SC.Secondary"
                android:layout_marginTop="12dp" />
            <Spinner
                android:id="@+id/catalogo_genero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:padding="8dp"
                android:background="@drawable/bg_card" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/field_maximo"
                style="@style/SC.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/tarifa_max">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_maximo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:inputType="numberDecimal"
                    android:maxLength="15"
                    android:minLines="1"
                    android:gravity="top|start" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/catalogo_limpiar"
                style="@style/SC.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/limpiar_filtros"
                android:layout_marginTop="12dp"
                android:maxLines="3" />
        </LinearLayout>
        <TextView
            android:id="@+id/catalogo_estado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cargando_datos"
            android:textAppearance="@style/SC.Secondary"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite" />
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/catalogo_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:indeterminate="true"
            android:contentDescription="@string/cargando_datos" />
        <TextView
            android:id="@+id/catalogo_conteo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/conteo_catalogo"
            android:textAppearance="@style/SC.Body"
            android:layout_marginTop="12dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/catalogo_comparar"
            style="@style/SC.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/comparar_seleccion"
            android:layout_marginTop="12dp"
            android:maxLines="3" />
        <LinearLayout
            android:id="@+id/catalogo_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="21dp"
            android:background="@drawable/bg_card"
            android:layout_marginTop="16dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sin_coincidencias"
                android:textAppearance="@style/SC.Heading" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/filtros_sugerencia"
                android:textAppearance="@style/SC.Secondary"
                android:layout_marginTop="8dp" />
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/catalogo_lista"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginTop="16dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/catalogo_retry"
            style="@style/SC.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/actualizar"
            android:layout_marginTop="12dp"
            android:maxLines="3" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
