# Copiar a backend/.env y completar. Este archivo NO contiene cuentas precargadas.
# El archivo se carga con tools/Iniciar-Backend.ps1 -EnvironmentFile backend/.env
DB_URL=jdbc:mysql://127.0.0.1:3306/santa_cecilia?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=REEMPLAZAR_CUENTA_APLICACION
DB_PASSWORD=REEMPLAZAR_SECRETO_APLICACION
DB_MIGRATION_USERNAME=REEMPLAZAR_CUENTA_MIGRACION
DB_MIGRATION_PASSWORD=REEMPLAZAR_SECRETO_MIGRACION
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
# Primer arranque unicamente; definir credenciales propias antes de habilitarlo.
APP_BOOTSTRAP_ENABLED=false
APP_BOOTSTRAP_EMAIL=
APP_BOOTSTRAP_PASSWORD=
APP_BOOTSTRAP_NOMBRES=Administrador
APP_BOOTSTRAP_APELLIDOS=Santa Cecilia
# Configurar para recuperacion real. Sin SMTP devuelve 503, no simula envios.
APP_PUBLIC_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
SMTP_STARTTLS=true

# Solo para HTTPS directo (tambien se puede usar un proxy TLS):
# SPRING_PROFILES_ACTIVE=https
# SERVER_PORT=8443
# TLS_KEY_STORE=file:C:/ruta-del-certificado/servidor.p12
# TLS_KEY_STORE_PASSWORD=REEMPLAZAR_SECRETO_DEL_CERTIFICADO
